# ==============================================================
# 《地球文明Online：山城溯源 2050》游戏配置模板
# 复制此文件为 .env 并填入你的 API Key
# ==============================================================

# Google Gemini API Key（支持免填使用内置拟真离线引擎）
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini 语言模型
VITE_GEMINI_MODEL=gemini-3.1-flash-lite

# Google Gemini 官方原生拟真语音模型 (Gemini Multimodal Live / TTS)
VITE_GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts

# 默认搭载提供商 (gemini / mock / deepseek / qwen / openai)
VITE_DEFAULT_AI_PROVIDER=gemini
